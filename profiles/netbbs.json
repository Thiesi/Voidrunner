{
  "name": "Voidrunner",
  "executable_path": "/usr/local/bin/python3",
  "args": ["{install_dir}/voidrunner.py"],
  "profile": {
    "version": 1,
    "adapter": "native",
    "endpoint": "stdio",
    "install_dir": "/var/games/netbbs/voidrunner",
    "encoding": "utf-8",
    "width": 0,
    "height": 0,
    "resize_signal": true,
    "max_sessions": 8,
    "multinode_certified": true,
    "environment": {}
  }
}
